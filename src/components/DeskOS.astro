---
// The desktop on the 3D monitor, and the home page's whole content: every
// part of the site is a file here. Once the monitor is unlocked, this is laid
// exactly over the screen (see Rack.astro), so its windows, links and the
// terminal are ordinary HTML: selectable, focusable and crawlable.
// On the monitor it is drawn at a fixed 1024×595 and scaled to the screen,
// like a real display. Where there is no 3D (small screens, weak devices,
// "turn off 3D") it fills the stage instead ("full"), and with scripts off
// index.astro lays the same windows out as a plain page.
import { site } from "../data/site.ts";
import { experience } from "../data/experience.ts";
import { deskFiles as files, dockFiles } from "../data/desktop.ts";

const linkedin = site.socials.find((s) => s.label === "LinkedIn");
const blog = site.nav.find((n) => n.label === "blog");
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const roles = experience.map((r) => ({ ...r, file: `${slug(r.company.split("·")[0])}.md` }));

const stackYaml = site.stack
  .map((s) => `${s.label.toLowerCase()}:  # ${s.sub}\n${s.items.map((i) => `  - ${i}`).join("\n")}`)
  .join("\n");
const signalsJson = JSON.stringify(
  site.signals.map((s) => ({ metric: s.label, value: `${s.value} ${s.unit}`, note: s.note })),
  null,
  2,
);
const aboutTxt = [
  `${site.name}, ${site.currentTitle} at ${site.currentCompany}.`,
  `Based in ${site.location}.`,
  "",
  "I build and secure cloud platforms that ship fast and stay up.",
  "Seven years across Kubernetes, Terraform, and hardened CI/CD, plus the",
  "observability and automation that keep production reliable.",
  "",
  "My path started in Kathmandu and runs through seven years of production",
  "systems: Java services first, then containers, then whole platforms on",
  "AWS and Azure. Off the clock I run a three-node Kubernetes homelab,",
  "practice Vim, and work through AIOps.",
  "",
  ...site.currently.map((c) => `${`${c.key}:`.padEnd(12)}${c.value}`),
].join("\n");
const year = new Date().getFullYear();
const age = (since: number) => (year - since > 0 ? `${year - since}y` : "new");
const statusLog = [
  `${"SERVICE".padEnd(22)}${"STATE".padEnd(13)}${"SINCE".padEnd(7)}AGE`,
  ...site.status.map((s) => `${s.name.padEnd(22)}${s.state.padEnd(13)}${String(s.since).padEnd(7)}${age(s.since)}`),
].join("\n");
const rulesMd = `# House rules\n\n${site.principles.map((p, i) => `${i + 1}. ${p}`).join("\n")}`;
const contactVcf = [
  "BEGIN:VCARD",
  `FN:${site.name}`,
  `TITLE:${site.currentTitle}`,
  `EMAIL:${site.email}`,
  linkedin ? `URL:${linkedin.href}` : "",
  `ADR:${site.location}`,
  "END:VCARD",
]
  .filter(Boolean)
  .join("\n");

// What `ls` and `cat` see in the terminal.
const fs: Record<string, string> = {
  "about.txt": aboutTxt,
  "stack.yaml": stackYaml,
  "signals.json": signalsJson,
  "status.log": statusLog,
  "house-rules.md": rulesMd,
  "contact.vcf": contactVcf,
  ...Object.fromEntries(
    roles.map((r) => [
      `experience/${r.file}`,
      `# ${r.company}\n${r.title} · ${r.year}\n\n${r.blurb}${r.impact ? `\n\n${r.impact.map((m) => `- ${m}`).join("\n")}` : ""}\n\ntags: ${r.tags.join(", ")}`,
    ]),
  ),
};
const term = {
  fs,
  open: Object.fromEntries([...files.map((f) => [f.name.toLowerCase(), f.id]), ...roles.map((r, i) => [`experience/${r.file}`, `role:${i}`])]),
  user: site.handle,
  host: "prod",
  region: site.region,
  age: `${new Date().getFullYear() - site.opsStart}y`,
  status: site.available ? site.availableLabel : "heads-down",
  email: site.email,
};

const icon: Record<string, string> = {
  txt: '<svg viewBox="0 0 44 52"><path d="M7 3h20l10 10v36H7z" fill="#f4f4f1"/><path d="M27 3v10h10z" fill="#cfd3d8"/><path d="M13 22h18M13 28h18M13 34h18M13 40h11" stroke="#9aa3ad" stroke-width="2" stroke-linecap="round"/></svg>',
  code: '<svg viewBox="0 0 44 52"><path d="M7 3h20l10 10v36H7z" fill="#f4f4f1"/><path d="M27 3v10h10z" fill="#cfd3d8"/><path d="M18 24l-5 6 5 6M26 24l5 6-5 6" fill="none" stroke="#3f6fd0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  chart: '<svg viewBox="0 0 44 52"><path d="M7 3h20l10 10v36H7z" fill="#f4f4f1"/><path d="M27 3v10h10z" fill="#cfd3d8"/><path d="M14 40V30M20 40V24M26 40V33M32 40V21" stroke="#2fae6d" stroke-width="3.2" stroke-linecap="round"/></svg>',
  card: '<svg viewBox="0 0 44 52"><rect x="4" y="11" width="36" height="30" rx="4" fill="#f4f4f1"/><circle cx="15" cy="23" r="5" fill="#8c97a3"/><path d="M8 37c1-6 13-6 14 0z" fill="#8c97a3"/><path d="M26 21h10M26 27h10M26 33h7" stroke="#9aa3ad" stroke-width="2" stroke-linecap="round"/></svg>',
  dir: '<svg viewBox="0 0 44 52"><path d="M3 14a3 3 0 013-3h10l4 5h18a3 3 0 013 3v22a3 3 0 01-3 3H6a3 3 0 01-3-3z" fill="#5aa9f0"/><path d="M3 21h38v20a3 3 0 01-3 3H6a3 3 0 01-3-3z" fill="#7fc1ff"/></svg>',
  term: '<svg viewBox="0 0 44 52"><rect x="3" y="8" width="38" height="36" rx="7" fill="#15181c" stroke="#3a4048" stroke-width="1.5"/><path d="M11 20l6 6-6 6M21 33h11" fill="none" stroke="#39e58c" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  link: '<svg viewBox="0 0 44 52"><circle cx="22" cy="26" r="17" fill="#f4f4f1"/><path d="M5 26h34M22 9c-9 9-9 25 0 34M22 9c9 9 9 25 0 34" fill="none" stroke="#3f6fd0" stroke-width="2"/></svg>',
};
---

<div class="os" data-os hidden>
  <canvas class="wall" data-os-wall aria-hidden="true"></canvas>

  <header class="mb">
    <span class="logo" aria-hidden="true">◆</span>
    <b data-os-app>Finder</b>
    <span class="mi" aria-hidden="true">File</span>
    <span class="mi" aria-hidden="true">Edit</span>
    <span class="mi" aria-hidden="true">View</span>
    <span class="mi" aria-hidden="true">Go</span>
    <span class="mi" aria-hidden="true">Window</span>
    <span class="sp"></span>
    <span class="st" aria-hidden="true">{site.region}</span>
    <span class="st" aria-hidden="true">100% ▮</span>
    <time data-os-clock></time>
  </header>

  <ul class="icons" aria-label="Files on the desktop">
    {
      files.map((f) => (
        <li>
          <button type="button" data-open={f.id}>
            <span class="ic" set:html={icon[f.kind]} />
            <span class="lb">{f.name}</span>
          </button>
        </li>
      ))
    }
    {
      blog ? (
        <li>
          <a href={blog.href} target="_blank" rel="noopener">
            <span class="ic" set:html={icon.link} />
            <span class="lb">blog ↗</span>
          </a>
        </li>
      ) : null
    }
  </ul>

  <section class="win" data-win="about" data-title="about.txt" hidden aria-label="about.txt">
    <div class="tb"><button class="x" type="button" data-close aria-label="Close about.txt"></button><i></i><i></i><span>about.txt</span></div>
    <div class="body doc">
      <h2>{site.name}</h2>
      <p class="sub">{site.currentTitle} <span>@ {site.currentCompany}</span> · {site.location}</p>
      <ul class="tags">
        {site.disciplines.map((d) => <li>{d}</li>)}
        <li class="warn">{site.learning} · learning</li>
      </ul>
      <p>
        I build and secure cloud platforms that <b>ship fast and stay up</b>. Seven years across Kubernetes, Terraform, and
        hardened CI/CD, plus the observability and automation that keep production reliable. Reliability and security, I
        treat as <b>the same job</b>.
      </p>
      <p>
        My path started in Kathmandu and runs through seven years of production systems: Java services first, then
        containers, then whole platforms on AWS and Azure. The thread: <b>the best infrastructure is the kind nobody
        notices, and the most secure is the kind an attacker never gets a foothold in.</b>
      </p>
      <p>
        Off the clock I run a three-node Kubernetes homelab, practice Vim, and I'm working through <b>AIOps</b>: anomaly
        detection and automated remediation on top of the observability I already run.
      </p>
      <dl class="kv">
        {site.currently.map((c) => <div><dt>{c.key}</dt><dd>{c.value}</dd></div>)}
        <div><dt>Status</dt><dd class="ok">{site.available ? site.availableLabel : "heads-down"}</dd></div>
      </dl>
    </div>
  </section>

  <section class="win wide" data-win="experience" data-title="experience" hidden aria-label="experience">
    <div class="tb"><button class="x" type="button" data-close aria-label="Close experience"></button><i></i><i></i><span>experience — {roles.length} items</span></div>
    <div class="body split">
      <ul class="side">
        {
          roles.map((r, i) => (
            <li>
              <button type="button" data-role={i} aria-pressed={i === 0 ? "true" : "false"}>
                <b>{r.file}</b>
                <span>{r.year}</span>
              </button>
            </li>
          ))
        }
      </ul>
      <div class="pane">
        {
          roles.map((r, i) => (
            <article data-role-pane={i} hidden={i !== 0}>
              <h2>{r.company}</h2>
              <p class="sub">{r.title} · {r.year}</p>
              <p>{r.blurb}</p>
              {r.impact ? <ul class="impact">{r.impact.map((m) => <li>{m}</li>)}</ul> : null}
              <ul class="tags">{r.tags.map((t) => <li>{t}</li>)}</ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="win" data-win="stack" data-title="stack.yaml" hidden aria-label="stack.yaml">
    <div class="tb"><button class="x" type="button" data-close aria-label="Close stack.yaml"></button><i></i><i></i><span>stack.yaml</span></div>
    <div class="body"><pre class="code">{stackYaml}</pre></div>
  </section>

  <section class="win wide" data-win="signals" data-title="signals.json" hidden aria-label="signals.json">
    <div class="tb"><button class="x" type="button" data-close aria-label="Close signals.json"></button><i></i><i></i><span>signals.json — numbers from production</span></div>
    <div class="body">
      <ul class="sig">
        {
          site.signals.map((s) => (
            <li>
              <b>{s.value}</b> <span class="u">{s.unit}</span>
              <span class="l">{s.label}</span>
              <span class="n">{s.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="win" data-win="status" data-title="status.log" hidden aria-label="status.log">
    <div class="tb"><button class="x" type="button" data-close aria-label="Close status.log"></button><i></i><i></i><span>status.log</span></div>
    <div class="body doc">
      <h2>Service status</h2>
      <p class="sub">Every discipline I run, tracked like a service.</p>
      <ul class="status">
        {
          site.status.map((s) => (
            <li>
              <b>{s.name}</b>
              <span>since {s.since} · {age(s.since)}</span>
              <em class={s.state === "canary" ? "warn" : ""}>{s.state}</em>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="win" data-win="rules" data-title="house-rules.md" hidden aria-label="house-rules.md">
    <div class="tb"><button class="x" type="button" data-close aria-label="Close house-rules.md"></button><i></i><i></i><span>house-rules.md</span></div>
    <div class="body doc">
      <h2>House rules</h2>
      <ol class="rules">{site.principles.map((p) => <li>{p}</li>)}</ol>
    </div>
  </section>

  <section class="win" data-win="contact" data-title="contact.vcf" hidden aria-label="contact.vcf">
    <div class="tb"><button class="x" type="button" data-close aria-label="Close contact.vcf"></button><i></i><i></i><span>contact.vcf</span></div>
    <div class="body doc">
      <h2>{site.name}</h2>
      <p class="sub">{site.currentTitle} · {site.location}</p>
      <p>
        {site.available ? `Currently ${site.availableLabel}.` : "Heads-down right now."} Open to platform engineering,
        reliability, and security work. The fastest way to reach me is email.
      </p>
      <p class="cta">
        <a class="b primary" href={`mailto:${site.email}`}>{site.email}</a>
        <button class="b" type="button" data-copy={site.email}>Copy address</button>
        {linkedin ? <a class="b" href={linkedin.href} target="_blank" rel="noopener">LinkedIn ↗</a> : null}
      </p>
    </div>
  </section>

  <section class="win wide dark" data-win="terminal" data-title="Terminal" hidden aria-label="Terminal">
    <div class="tb"><button class="x" type="button" data-close aria-label="Close Terminal"></button><i></i><i></i><span>{site.handle}@prod: ~</span></div>
    <div class="body term" data-term={JSON.stringify(term)}>
      <div class="out" data-term-out aria-live="polite"></div>
      <form data-term-form autocomplete="off">
        <label for="os-term-in"><span class="pr">$</span><span class="sr">Terminal command</span></label>
        <input id="os-term-in" data-term-in type="text" spellcheck="false" autocapitalize="off" autocomplete="off" />
      </form>
    </div>
  </section>

  <nav class="dock" aria-label="Dock">
    {
      dockFiles.map((id) => {
        const f = files.find((x) => x.id === id)!;
        return (
          <button type="button" data-open={f.id} aria-label={`Open ${f.name}`} title={f.name}>
            <span class="ic" set:html={icon[f.kind]} />
          </button>
        );
      })
    }
  </nav>
</div>

<script>
  const os = document.querySelector<HTMLElement>("[data-os]");
  if (os) {
    const wins = Array.from(os.querySelectorAll<HTMLElement>("[data-win]"));
    const app = os.querySelector<HTMLElement>("[data-os-app]");
    const byId = (id: string) => wins.find((w) => w.dataset.win === id);
    const scale = () => os.getBoundingClientRect().width / (os.offsetWidth || 1) || 1;
    // Filling a small stage, windows are maximised and do not move.
    const small = matchMedia("(max-width: 900px)");
    const maxed = () => os.classList.contains("full") && small.matches;
    const behind = [os.querySelector<HTMLElement>(".icons"), os.querySelector<HTMLElement>(".dock")];
    let z = 10;
    let placed = 0;
    let top: HTMLElement | null = null;

    function front(w: HTMLElement | null) {
      if (w) w.style.zIndex = String(++z);
      top = w;
      wins.forEach((x) => x.classList.toggle("active", x === w));
      if (app) app.textContent = w ? (w.dataset.win === "terminal" ? "Terminal" : "Finder") : "Finder";
      cover();
    }
    // A maximised window hides the icons, the dock and every other window.
    // Keep keyboard focus and screen readers off what cannot be seen.
    function cover() {
      const on = maxed() && !!top;
      behind.forEach((el) => el && (el.inert = on));
      wins.forEach((x) => (x.inert = on && x !== top));
    }
    small.addEventListener("change", cover);
    new MutationObserver(cover).observe(os, { attributes: true, attributeFilter: ["class"] });
    const focusWin = (w: HTMLElement) =>
      (w.dataset.win === "terminal" ? os.querySelector<HTMLElement>("[data-term-in]") : w.querySelector<HTMLElement>("[data-close]"))?.focus({
        preventScroll: true,
      });
    /** `quiet` opens without moving focus (the page opening a file by itself). */
    function open(id: string, quiet = false) {
      const [kind, arg] = id.split(":");
      const w = byId(kind === "role" ? "experience" : id);
      if (!w) return false;
      if (kind === "role") role(Number(arg));
      if (w.hidden) {
        w.hidden = false;
        if (!w.dataset.placed) {
          w.dataset.placed = "1";
          w.style.left = `${70 + (placed % 5) * 34}px`;
          w.style.top = `${44 + (placed % 5) * 26}px`;
          placed++;
        }
      }
      front(w);
      if (!quiet) focusWin(w);
      return true;
    }
    function close(w: HTMLElement) {
      w.hidden = true;
      const next = wins.filter((x) => !x.hidden).sort((a, b) => Number(b.style.zIndex) - Number(a.style.zIndex))[0] ?? null;
      front(next);
      // Back to the file's icon, or to the window now in front when that
      // one covers the icons.
      if (next && maxed()) focusWin(next);
      else os.querySelector<HTMLElement>(`.icons [data-open="${w.dataset.win}"]`)?.focus({ preventScroll: true });
    }
    function role(i: number) {
      os.querySelectorAll<HTMLElement>("[data-role]").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.role) === i)));
      os.querySelectorAll<HTMLElement>("[data-role-pane]").forEach((p) => (p.hidden = Number(p.dataset.rolePane) !== i));
    }

    os.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      const o = t.closest<HTMLElement>("[data-open]");
      if (o) return void open(o.dataset.open!);
      const c = t.closest<HTMLElement>("[data-close]");
      if (c) return void close(c.closest<HTMLElement>("[data-win]")!);
      const r = t.closest<HTMLElement>("[data-role]");
      if (r) return void role(Number(r.dataset.role));
    });
    // A window comes to the front when it is clicked or tabbed into.
    const raise = (e: Event) => {
      const w = (e.target as HTMLElement).closest<HTMLElement>("[data-win]");
      if (w && w !== top) front(w);
    };
    os.addEventListener("pointerdown", raise);
    os.addEventListener("focusin", raise);
    // Rack.astro, once the desktop it opened a file on has become visible.
    os.addEventListener("os:focus", () => top && focusWin(top));
    // Rack.astro asks for a file by name (nav links, deep links).
    os.addEventListener("os:open", (e) => {
      const d = (e as CustomEvent<string | { id: string; quiet?: boolean }>).detail;
      if (typeof d === "string") open(d);
      else open(d.id, !!d.quiet);
    });

    // Drag a window by its title bar. Movement is divided by the display scale.
    wins.forEach((w) => {
      const bar = w.querySelector<HTMLElement>(".tb");
      if (!bar) return;
      let from: { x: number; y: number; l: number; t: number; id: number } | null = null;
      bar.addEventListener("pointerdown", (e) => {
        if ((e.target as HTMLElement).closest("button") || maxed()) return;
        from = { x: e.clientX, y: e.clientY, l: w.offsetLeft, t: w.offsetTop, id: e.pointerId };
        bar.setPointerCapture(e.pointerId);
      });
      bar.addEventListener("pointermove", (e) => {
        if (!from || e.pointerId !== from.id) return;
        const s = scale();
        const l = from.l + (e.clientX - from.x) / s;
        const t = from.t + (e.clientY - from.y) / s;
        w.style.left = `${Math.max(-w.offsetWidth + 80, Math.min(l, os.offsetWidth - 80))}px`;
        w.style.top = `${Math.max(26, Math.min(t, os.offsetHeight - 60))}px`;
      });
      const drop = (e: PointerEvent) => {
        if (from && e.pointerId === from.id) from = null;
      };
      bar.addEventListener("pointerup", drop);
      bar.addEventListener("pointercancel", drop);
    });

    // Menu bar clock.
    const clock = os.querySelector<HTMLElement>("[data-os-clock]");
    const fmt = new Intl.DateTimeFormat("en-CA", { weekday: "short", month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
    const tick = () => {
      if (clock) clock.textContent = fmt.format(new Date()).replace(/,/g, "");
    };
    tick();
    setInterval(tick, 20_000);

    // ── terminal ─────────────────────────────────────────────────────────
    const termEl = os.querySelector<HTMLElement>("[data-term]");
    const out = os.querySelector<HTMLElement>("[data-term-out]");
    const form = os.querySelector<HTMLFormElement>("[data-term-form]");
    const input = os.querySelector<HTMLInputElement>("[data-term-in]");
    if (termEl && out && form && input) {
      const T = JSON.parse(termEl.dataset.term || "{}") as {
        fs: Record<string, string>;
        open: Record<string, string>;
        user: string;
        host: string;
        region: string;
        age: string;
        status: string;
        email: string;
      };
      const history: string[] = [];
      let at = 0;
      const print = (text: string, cls = "") => {
        const d = document.createElement("div");
        if (cls) d.className = cls;
        d.textContent = text;
        out.append(d);
        termEl.scrollTop = termEl.scrollHeight;
      };
      const ls = (dir: string) => {
        const names = Object.keys(T.fs);
        if (!dir || dir === "." || dir === "~") return [...new Set(names.map((n) => (n.includes("/") ? `${n.split("/")[0]}/` : n)))].join("   ");
        const d = dir.replace(/\/$/, "");
        const inside = names.filter((n) => n.startsWith(`${d}/`)).map((n) => n.slice(d.length + 1));
        return inside.length ? inside.join("   ") : null;
      };
      const pad = (s: string, n: number) => s.padEnd(n, " ");
      const engineer = `${pad("NAME", 14)}${pad("READY", 7)}${pad("STATUS", 9)}AGE\n${pad(T.user, 14)}${pad("1/1", 7)}${pad("Running", 9)}${T.age}`;
      const help = [
        "ls [dir]            list files",
        "cat <file>          print a file",
        "open <file>         open a file in a window",
        "status              service status",
        "kubectl get engineer",
        "whoami · date · uptime · clear · exit",
      ].join("\n");

      function run(line: string) {
        const cmd = line.trim();
        print(`$ ${cmd}`, "cmd");
        if (!cmd) return;
        const [name, ...rest] = cmd.split(/\s+/);
        const arg = rest.join(" ").replace(/^\.\//, "");
        switch (name) {
          case "help":
            return print(help);
          case "ls": {
            const r = ls(arg);
            return print(r ?? `ls: ${arg}: No such file or directory`, r ? "" : "err");
          }
          case "cat": {
            if (!arg) return print("usage: cat <file>", "err");
            const f = T.fs[arg] ?? T.fs[arg.toLowerCase()];
            if (f != null) return print(f);
            return print(ls(arg) ? `cat: ${arg}: Is a directory` : `cat: ${arg}: No such file or directory`, "err");
          }
          case "open": {
            const id = T.open[arg.toLowerCase().replace(/\/$/, "")];
            if (!id || !open(id)) return print(`open: ${arg || "(nothing)"}: No such file`, "err");
            return;
          }
          case "kubectl":
            if (/^get\s+engineers?/.test(arg)) return print(engineer);
            if (/^describe\s+engineer/.test(arg)) return print(T.fs["about.txt"]);
            return print(`kubectl: try "kubectl get engineer"`, "err");
          case "status":
            return print(T.fs["status.log"]);
          case "whoami":
            return print(`${T.user} (${T.status})`);
          case "pwd":
            return print(`/home/${T.user}`);
          case "date":
            return print(new Date().toString());
          case "uptime":
            return print(`up ${T.age} in production, load average: calm`);
          case "echo":
            return print(arg);
          case "clear":
            out.replaceChildren();
            return;
          case "sudo":
            return print(`${T.user} is not in the sudoers file. This incident will be reported.`, "err");
          case "exit":
            return void close(byId("terminal")!);
          case "mail":
          case "email":
            location.href = `mailto:${T.email}`;
            return;
          default:
            return print(`${name}: command not found. Try "help".`, "err");
        }
      }

      print(`Last login from ${T.region}. Type "help" for commands.`, "dim");
      run("kubectl get engineer");
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const v = input.value;
        input.value = "";
        if (v.trim()) history.push(v);
        at = history.length;
        run(v);
      });
      input.addEventListener("keydown", (e) => {
        if (e.key === "ArrowUp" && at > 0) input.value = history[--at] ?? "";
        else if (e.key === "ArrowDown") input.value = history[++at] ?? ((at = history.length), "");
        else if (e.key === "Tab" && !e.shiftKey) {
          // Complete the last word against the file names. With nothing
          // typed to complete, Tab moves focus on as it does anywhere else.
          const parts = input.value.split(/\s+/);
          const last = parts.pop() ?? "";
          if (!last) return;
          e.preventDefault();
          const hit = Object.keys(T.fs).filter((n) => n.startsWith(last));
          if (hit.length === 1) input.value = [...parts, hit[0]].join(" ");
        }
      });
      termEl.addEventListener("click", () => {
        if (!getSelection()?.toString()) input.focus({ preventScroll: true });
      });
    }
  }
</script>

