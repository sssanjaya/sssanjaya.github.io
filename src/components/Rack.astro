---
// The 3D desk. While it runs it is the whole page: the sections below it and
// the footer are hidden, and the desk's own computer holds their content
// (DeskOS.astro). It is progressive enhancement over the plain page: the stage
// stays hidden until WebGL is confirmed and the first frame is ready, and
// "plain view" (or a weak device, or no WebGL) leaves the regular page as is.
// The panels and the desktop's windows are ordinary HTML, so their text is
// crawlable.
import { site } from "../data/site.ts";
import { experience } from "../data/experience.ts";
import DeskOS from "./DeskOS.astro";

const linkedin = site.socials.find((s) => s.label === "LinkedIn");
const aiops = site.status.find((s) => s.name === "AIOps");
const core = site.stack.filter((s) => s.place === "core");
const cross = site.stack.filter((s) => s.place !== "core");

const hots = [
  { id: "console", label: "computer" },
  ...experience.map((r, i) => ({ id: `role-${i}`, label: r.company.split(" ")[0].toLowerCase() })),
  { id: "aiops", label: "aiops" },
  { id: "stack", label: "stack" },
  { id: "signals", label: "signals" },
  { id: "principles", label: "rules" },
  { id: "contact", label: "phone" },
];
---

<section class="rack" data-rack hidden aria-label="Interactive desk">
  <canvas data-rack-canvas aria-hidden="true"></canvas>
  <div class="veil" aria-hidden="true"></div>

  <div class="ident">
    <p class="nm" role="heading" aria-level="1">{site.name}</p>
    <p class="rl">{site.currentTitle} <span>@ {site.currentCompany}</span></p>
  </div>

  <div class="foot">
    <p class="how">Everything on this desk works. Click the monitor to unlock it, or try a lamp.</p>
    <nav class="units" data-rack-units aria-label="Desk items">
      {
        hots.map((h, i) => (
          <button type="button" data-hot={h.id} aria-pressed="false">
            <kbd aria-hidden="true">{i + 1 === 10 ? 0 : i + 1}</kbd>
            {h.label}
          </button>
        ))
      }
    </nav>
  </div>

  <div class="hud">
    <button class="hbtn back" type="button" data-rack-back hidden>
      <kbd aria-hidden="true">esc</kbd> back to the desk
    </button>
    <button class="hbtn" type="button" data-rack-off>plain view</button>
  </div>

  <DeskOS />

  <div class="tip mono" data-rack-tip aria-hidden="true"></div>

  <aside class="sheet panel" data-rack-sheet hidden aria-live="polite">
    <button class="x" type="button" data-rack-close aria-label="Close and step back">
      <span aria-hidden="true">esc ✕</span>
    </button>

    {
      experience.map((r, i) => (
        <article data-panel={`role-${i}`} hidden>
          <p class="kick">
            <span class="dot" aria-hidden="true" />
            book {experience.length - i} of {experience.length} · {r.year}
          </p>
          <h2>{r.company}</h2>
          <p class="sub">{r.title}</p>
          <p class="body">{r.blurb}</p>
          {r.impact ? <ul class="impact">{r.impact.map((m) => <li>{m}</li>)}</ul> : null}
          <ul class="tags">{r.tags.map((t) => <li class="chip">{t}</li>)}</ul>
          <p class="more"><button type="button" data-os-open={`role:${i}`}>open on the computer <span aria-hidden="true">→</span></button></p>
        </article>
      ))
    }

    <article data-panel="aiops" hidden>
      <p class="kick warn"><span class="dot warn" aria-hidden="true"></span> succulent · canary{aiops ? ` since ${aiops.since}` : ""}</p>
      <h2>{site.learning}</h2>
      <p class="body">
        The newest thing on the desk, small and still growing. It gets a
        little traffic and plenty of attention, and it is not promoted to
        production yet.
      </p>
      <dl class="kv">
        {site.currently.filter((c) => ["Learning", "Reading", "Practicing"].includes(c.key)).map((c) => <div><dt>{c.key}</dt><dd>{c.value}</dd></div>)}
      </dl>
    </article>

    <article data-panel="stack" hidden>
      <p class="kick"><span class="dot" aria-hidden="true"></span> keyboard · stack</p>
      <h2>What it all runs on</h2>
      <dl class="kv wide">
        {core.map((s) => <div><dt>{s.label}</dt><dd>{s.items.join(" · ")}</dd></div>)}
        {cross.map((s) => <div><dt>{s.label}</dt><dd>{s.items.join(" · ")}</dd></div>)}
      </dl>
      <p class="more"><button type="button" data-os-open="stack">open stack.yaml <span aria-hidden="true">→</span></button></p>
    </article>

    <article data-panel="signals" hidden>
      <p class="kick"><span class="dot" aria-hidden="true"></span> laptop · golden signals</p>
      <h2>Numbers from production</h2>
      <ul class="sig">
        {site.signals.map((s) => (
          <li>
            <b>{s.value}</b> <span class="u">{s.unit}</span>
            <span class="l">{s.label}</span>
          </li>
        ))}
      </ul>
      <p class="more"><button type="button" data-os-open="signals">open signals.json <span aria-hidden="true">→</span></button></p>
    </article>

    <article data-panel="principles" hidden>
      <p class="kick"><span class="dot" aria-hidden="true"></span> sticky notes</p>
      <h2>House rules</h2>
      <ol class="rules">{site.principles.map((p) => <li>{p}</li>)}</ol>
    </article>

    <article data-panel="contact" hidden>
      <p class="kick crit"><span class="dot crit" aria-hidden="true"></span> phone</p>
      <h2>Page me</h2>
      <p class="body">
        {site.available ? `Currently ${site.availableLabel}.` : "Heads-down right now, but the phone is on."}{" "}
        Based in {site.location}.
      </p>
      <div class="cta">
        <a class="btn primary" href={`mailto:${site.email}`}>Send email <span class="arr" aria-hidden="true">→</span></a>
        <button class="btn" type="button" data-copy={site.email}>Copy address</button>
        {linkedin ? <a class="btn" href={linkedin.href} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a> : null}
      </div>
    </article>
  </aside>
</section>

<script>
  import type { RackController, ScreenRect } from "../scripts/rack.ts";
  import { DESK_W } from "../data/desktop.ts";

  const root = document.documentElement;
  const stage = document.querySelector<HTMLElement>("[data-rack]");
  const canvas = stage?.querySelector<HTMLCanvasElement>("[data-rack-canvas]");
  const sheet = stage?.querySelector<HTMLElement>("[data-rack-sheet]");
  const tip = stage?.querySelector<HTMLElement>("[data-rack-tip]");
  const units = stage?.querySelector<HTMLElement>("[data-rack-units]");
  const back = stage?.querySelector<HTMLButtonElement>("[data-rack-back]");
  const os = stage?.querySelector<HTMLElement>("[data-os]");
  const buttons = Array.from(stage?.querySelectorAll<HTMLButtonElement>("[data-hot]") ?? []);
  // Below this width the monitor is too small to read, so the desktop takes
  // the whole stage instead of sitting on the screen.
  const narrow = matchMedia("(max-width: 900px)");
  let ctl: RackController | null = null;
  let current: string | null = null;

  const pref = () => {
    try {
      return localStorage.getItem("rack");
    } catch {
      return null;
    }
  };
  const remember = (v: string) => {
    try {
      localStorage.setItem("rack", v);
    } catch {
      /* storage blocked */
    }
  };

  function capable() {
    // Short screens (landscape phones, zoomed windows) cannot fit the stage:
    // top bar plus the stage's min-height at each breakpoint in the CSS below.
    const w = window.innerWidth;
    if (window.innerHeight < (w <= 760 ? 536 : w <= 880 ? 656 : 620)) return false;
    const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
    if (nav.connection?.saveData) return false;
    if ((nav.deviceMemory ?? 8) < 4 || (navigator.hardwareConcurrency ?? 8) < 4) return false;
    try {
      // three.js needs WebGL 2. A software renderer (no usable GPU, a VM)
      // would run the scene at a few frames a second, so it stays opt-in.
      const gl = document.createElement("canvas").getContext("webgl2", { failIfMajorPerformanceCaveat: true });
      if (!gl) return false;
      const info = gl.getExtension("WEBGL_debug_renderer_info");
      const renderer = String(gl.getParameter(info ? info.UNMASKED_RENDERER_WEBGL : gl.RENDERER));
      gl.getExtension("WEBGL_lose_context")?.loseContext();
      if (/swiftshader|llvmpipe|softpipe|software|basic render/i.test(renderer)) return false;
    } catch {
      return false;
    }
    return true;
  }

  // The scene reports where the monitor's screen is, every frame, while the
  // unlocked computer is in use. The HTML desktop is laid exactly over it.
  let osAt = "";
  function showOs(rect: ScreenRect | null) {
    if (!os) return;
    if (!rect) {
      if (os.hidden) return;
      os.classList.remove("on");
      os.hidden = true;
      osAt = "";
      return;
    }
    const full = narrow.matches;
    const at = full ? "full" : `translate(${rect.x.toFixed(1)}px,${rect.y.toFixed(1)}px) scale(${(rect.w / DESK_W).toFixed(4)})`;
    if (at !== osAt) {
      osAt = at;
      os.classList.toggle("full", full);
      os.style.transform = full ? "" : at;
    }
    if (!os.hidden) return;
    // Phones have no screen behind the desktop, so it carries the wallpaper.
    const wall = os.querySelector<HTMLCanvasElement>("[data-os-wall]");
    const paper = ctl?.wallpaper;
    if (full && wall && paper && wall.width !== paper.width) {
      wall.width = paper.width;
      wall.height = paper.height;
      wall.getContext("2d")?.drawImage(paper, 0, 0);
    }
    os.hidden = false;
    requestAnimationFrame(() => os.classList.add("on"));
  }

  function select(id: string | null, returnFocus = true) {
    if (!stage || !sheet) return;
    const prev = current;
    const active = document.activeElement;
    const using = id === "console";
    // Closing hides whatever is focused in the sheet or on the computer; hand
    // focus back to the unit's button so keyboard users are not dropped at
    // the page start.
    const inSheet = sheet.contains(active);
    const inOs = !!os?.contains(active) || active === back;
    const refocus = !id && returnFocus && (inSheet || inOs);
    // Switching panels hides the old panel; keep focus in the sheet.
    const closeBtn = sheet.querySelector<HTMLElement>("[data-rack-close]");
    const keep = !!id && !using && id !== prev && inSheet && active !== closeBtn;
    // Sitting down at the computer hides the unit buttons.
    const toBack = using && (!!units?.contains(active) || inSheet);
    current = id;
    ctl?.select(id);
    stage.classList.toggle("focused", !!id);
    stage.classList.toggle("using", using);
    if (id) stage.classList.add("touched");
    sheet.hidden = !id || using;
    sheet.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => (p.hidden = p.dataset.panel !== id));
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.hot === id)));
    if (units) units.inert = using;
    if (back) back.hidden = !using;
    if (!using) showOs(null);
    sheet.scrollTop = 0;
    if (refocus) buttons.find((b) => b.dataset.hot === prev)?.focus({ preventScroll: true });
    else if (keep) closeBtn?.focus({ preventScroll: true });
    else if (toBack) back?.focus({ preventScroll: true });
  }

  /** Go to the computer and open one of its files (see DeskOS.astro). */
  function openFile(name: string) {
    select("console");
    os?.dispatchEvent(new CustomEvent("os:open", { detail: name }));
  }

  function showTip(label: string | null, x: number, y: number) {
    if (!stage || !tip) return;
    tip.textContent = label ?? "";
    tip.classList.toggle("on", !!label);
    if (!label) return;
    const r = stage.getBoundingClientRect();
    const tx = Math.max(8, Math.min(x - r.left + 14, r.width - tip.offsetWidth - 8));
    tip.style.transform = `translate(${tx}px, ${y - r.top + 16}px)`;
  }

  // `wanted` is the latest request (start or stop); `starting` marks the one
  // load in flight. Together they make start() single-flight and cancellable:
  // a stop during loading disposes the scene instead of swapping it in.
  let wanted = false;
  let starting = false;
  // The control that asked for the scene from the keyboard, if any. It is
  // hidden once the scene is up, so focus is handed into the scene then.
  let focusTrigger: Element | null = null;

  async function start(focusAfter = false, auto = false) {
    if (!stage || !canvas) return;
    wanted = true;
    if (ctl) return;
    if (focusAfter) focusTrigger = document.activeElement;
    // While loading, the stage is laid out (the scene sizes itself from it)
    // but invisible and out of flow, so the plain page stays put until the
    // scene is ready to replace it.
    stage.classList.add("pending");
    stage.hidden = false;
    if (starting) return;
    starting = true;
    try {
      const { initRack } = await import("../scripts/rack.ts");
      const c = await initRack(stage, canvas, { select, hover: showTip, screen: showOs });
      // The scene replaces the whole page. A visitor who did not ask for it
      // and is already reading further down keeps the page they have.
      if (!wanted || (auto && window.scrollY > 80)) {
        c.dispose();
        stage.hidden = true;
        return;
      }
      ctl = c;
      // Only take focus if the visitor has not moved it elsewhere meanwhile.
      const active = document.activeElement;
      const takeFocus = !!focusTrigger && (active === focusTrigger || active === document.body || !active);
      stage.hidden = false;
      stage.classList.remove("pending");
      root.classList.add("rack-on");
      window.scrollTo({ top: 0, behavior: "instant" });
      requestAnimationFrame(() => stage.classList.add("ready"));
      if (takeFocus) buttons[0]?.focus({ preventScroll: true });
    } catch (err) {
      console.warn("3D view unavailable, staying on the plain page.", err);
      stage.hidden = true;
    } finally {
      stage.classList.remove("pending");
      starting = false;
      focusTrigger = null;
    }
  }

  function stop() {
    wanted = false;
    select(null);
    ctl?.dispose();
    ctl = null;
    root.classList.remove("rack-on");
    stage?.classList.remove("ready", "touched");
    if (stage) stage.hidden = true;
  }

  // The top bar and the command palette link to page sections (/#stack).
  // While the desk is the page, each one is a file on the computer instead.
  const sectionFile: Record<string, string> = {
    signals: "signals",
    status: "terminal",
    experience: "experience",
    stack: "stack",
    about: "about",
    contact: "contact",
  };
  function fromHash() {
    const file = sectionFile[location.hash.slice(1)];
    if (!ctl || !file) return;
    history.replaceState(null, "", location.pathname + location.search);
    window.scrollTo({ top: 0, behavior: "instant" });
    openFile(file);
  }

  if (stage && canvas) {
    buttons.forEach((b) => b.addEventListener("click", () => select(current === b.dataset.hot ? null : b.dataset.hot!)));
    // On phones the units are a horizontal strip: bring a keyboard-focused
    // button into it. Keyboard only: scrolling under a tap would move the
    // button away between press and release and lose the tap. Scrolls the
    // strip, never the page.
    buttons.forEach((b) =>
      b.addEventListener("focus", () => {
        const strip = b.parentElement;
        if (!strip || !b.matches(":focus-visible") || strip.scrollWidth <= strip.clientWidth) return;
        strip.scrollTo({ left: b.offsetLeft - (strip.clientWidth - b.offsetWidth) / 2 });
      }),
    );
    stage.querySelector("[data-rack-close]")?.addEventListener("click", () => select(null));
    back?.addEventListener("click", () => select(null));
    stage.querySelector("[data-rack-off]")?.addEventListener("click", () => {
      remember("off");
      stop();
      document.querySelector<HTMLElement>("[data-rack-on]")?.focus();
    });
    document.querySelectorAll("[data-rack-on]").forEach((b) =>
      b.addEventListener("click", () => {
        remember("on");
        // The trigger is hidden once the scene is up; move focus into it.
        void start(document.activeElement === b);
      }),
    );
    // A panel can hand over to the matching file on the computer.
    sheet?.querySelectorAll<HTMLElement>("[data-os-open]").forEach((b) => b.addEventListener("click", () => openFile(b.dataset.osOpen!)));
    window.addEventListener("hashchange", fromHash);

    window.addEventListener("keydown", (e) => {
      if (!ctl || e.metaKey || e.ctrlKey || e.altKey) return;
      if (document.querySelector("dialog[open]")) return;
      const t = e.target as HTMLElement | null;
      if (t?.closest("dialog")) return;
      // Escape always steps back, even from the computer's terminal.
      if (e.key === "Escape") {
        if (current) select(null);
        return;
      }
      // At the computer, keys are for the computer.
      if (current === "console" || (t && (t.closest("input, textarea") || t.isContentEditable))) return;
      if (/^[0-9]$/.test(e.key)) {
        const b = buttons[(Number(e.key) + 9) % 10];
        if (b) select(current === b.dataset.hot ? null : b.dataset.hot!);
      }
    });

    // A deep link (/#experience) is scrolling to its section right now, and
    // that section only exists on the plain page.
    const deep = location.hash.length > 1 && location.hash !== "#top";
    const p = pref();
    if (!deep && p !== "off" && (p === "on" || capable())) void start(false, true);
  }
</script>

<style>
  .rack {
    position: relative;
    /* The desk is the page: all of the window under the top bar (60px + its border). */
    height: calc(100svh - 61px);
    min-height: 560px;
    overflow: hidden;
    background: #0c0907;
    border-bottom: 1px solid var(--line);
    /* The room is an evening scene in both themes; the light theme lets daylight in. */
    --fg: #e6ebf2;
    --fg-2: #c3ccd8;
    --mut: #9aa6b7;
    --ok: #39e58c;
    --warn: #ffb02e;
    --crit: #ff5f56;
    --panel: rgba(10, 14, 19, 0.88);
    --panel-2: rgba(255, 255, 255, 0.05);
    --line: rgba(255, 255, 255, 0.1);
    --line-2: rgba(255, 255, 255, 0.18);
    --ok-soft: rgba(57, 229, 140, 0.12);
    --ok-line: rgba(57, 229, 140, 0.32);
    color: var(--fg);
  }
  .rack[hidden] {
    display: none;
  }
  .rack.pending {
    position: absolute;
    left: 0;
    right: 0;
    visibility: hidden;
    pointer-events: none;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.9s ease;
    touch-action: pan-y pinch-zoom;
  }
  .ready canvas {
    opacity: 1;
  }
  .veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(12, 9, 7, 0.45) 0%, rgba(12, 9, 7, 0) 14%),
      linear-gradient(0deg, rgba(12, 9, 7, 0.7) 0%, rgba(12, 9, 7, 0) 20%);
    transition: opacity 0.4s ease;
  }
  /* Up close the picture should be clean. */
  .focused .veil {
    opacity: 0.3;
  }
  .using .veil {
    opacity: 0;
  }

  /* A small name tag top-left; the hint and the unit row along the bottom. */
  .ident {
    position: absolute;
    --edge: max(var(--gutter), calc((100% - var(--maxw)) / 2 + var(--gutter)));
    left: var(--edge);
    top: 20px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .foot {
    position: absolute;
    --edge: max(var(--gutter), calc((100% - var(--maxw)) / 2 + var(--gutter)));
    left: var(--edge);
    right: calc(var(--edge) + 130px);
    bottom: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .ready .ident {
    opacity: 1;
    transition-delay: 0.5s;
  }
  /* At the computer there is only the computer. */
  .using .ident,
  .using .foot {
    opacity: 0;
    transition-delay: 0s;
  }
  .nm {
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.8);
  }
  .rl {
    margin-top: 4px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--fg-2);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.8);
  }
  .rl span {
    color: var(--ok);
  }
  .how {
    font-size: 13px;
    color: var(--fg-2);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .ready .how {
    opacity: 1;
    transition-delay: 1.4s;
  }
  /* The hint has done its job after the first click. */
  .touched .how {
    opacity: 0;
    transition-delay: 0s;
  }

  .units {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    pointer-events: auto;
  }
  .units button,
  .hbtn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1;
    padding: 8px 10px;
    border-radius: 7px;
    border: 1px solid var(--line);
    background: rgba(10, 14, 19, 0.72);
    color: var(--fg-2);
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: border-color 0.15s, color 0.15s;
  }
  .units button:hover,
  .hbtn:hover {
    border-color: var(--line-2);
    color: var(--fg);
  }
  .units button[aria-pressed="true"] {
    border-color: var(--ok-line);
    background: var(--ok-soft);
    color: var(--ok);
  }
  .units kbd,
  .hbtn kbd {
    font-size: 10.5px;
    padding: 1px 4px;
    border-color: var(--line-2);
    background: transparent;
    color: var(--mut);
  }
  .hud {
    position: absolute;
    z-index: 5;
    right: max(var(--gutter), calc((100% - var(--maxw)) / 2 + var(--gutter)));
    bottom: 18px;
    display: flex;
    gap: 6px;
  }
  .hbtn[hidden] {
    display: none;
  }
  .hbtn.back {
    border-color: var(--ok-line);
    color: var(--fg);
  }

  .tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    pointer-events: none;
    font-size: 12px;
    padding: 6px 9px;
    border-radius: 6px;
    border: 1px solid var(--ok-line);
    background: rgba(12, 9, 7, 0.9);
    color: var(--ok);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.12s;
  }
  .tip.on {
    opacity: 1;
  }

  .sheet {
    position: absolute;
    z-index: 4;
    top: 32px;
    right: max(var(--gutter), calc((100% - var(--maxw)) / 2 + var(--gutter)));
    width: min(430px, 42%);
    max-height: calc(100% - 100px);
    overflow-y: auto;
    padding: 26px 26px 22px;
    backdrop-filter: blur(14px);
    animation: in 0.35s ease both;
  }
  .sheet[hidden] {
    display: none;
  }
  @keyframes in {
    from {
      opacity: 0;
      transform: translateX(14px);
    }
  }
  .x {
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: var(--mono);
    font-size: 11.5px;
    padding: 6px 8px;
    border-radius: 6px;
