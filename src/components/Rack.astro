  @media (max-width: 760px) {
    .rack {
      min-height: 440px;
    }
    .how {
      display: none;
    }
    /* Phones: name tag top-left, units in a swipeable strip at the bottom. */
    .ident {
      top: 14px;
    }
    .nm {
      font-size: 19px;
    }
    .foot {
      left: 0;
      right: 0;
      bottom: 8px;
    }
    .units {
      /* Vertical padding leaves room for the focus ring inside the scrollport. */
      padding: 6px var(--gutter);
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .units::-webkit-scrollbar {
      display: none;
    }
    .hud {
      bottom: auto;
      top: 14px;
    }
    /* The desktop fills the stage here; the way back sits under its dock. */
    .using .hud {
      top: auto;
      bottom: 10px;
      right: 50%;
      transform: translateX(50%);
    }
    .using [data-rack-off] {
      display: none;
    }
    .sheet {
      top: auto;
      right: 10px;
      left: 10px;
      bottom: 58px;
      width: auto;
      max-height: 50%;
      padding: 20px 18px 18px;
      animation-name: up;
    }
    @keyframes up {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
    }
  }
  /* Where the unit row wraps to two lines, keep the sheet clear of it. */
  @media (min-width: 761px) and (max-width: 1200px) {
    .sheet {
      max-height: calc(100% - 140px);
    }
  }
  /* The top bar wraps to two rows (96px) at this width; see TopBar.astro. */
  @media (max-width: 880px) {
    .rack {
      height: calc(100svh - 96px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    canvas,
    .ident,
    .foot,
    .how,
    .veil {
      transition: none;
    }
    .sheet {
      animation: none;
    }
  }
</style>

<style is:global>
  /* While the 3D desk runs it is the whole page: every other section and
     the footer are hidden, and come back with "plain view". */
  /* html. prefix: must outrank the sections' own scoped display rules. */
  html.rack-on main > :not(.rack),
  html.rack-on footer.site {
    display: none;
  }
  /* The room is dark in both themes, so keep the dark-theme button text. */
  :root[data-theme="light"] .rack .btn.primary {
    color: #04130b;
  }
</style>
