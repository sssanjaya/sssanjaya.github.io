---
// Experience as a deploy history: newest release on top, the current role
// "running", past roles exited cleanly.
import SectionHead from "./SectionHead.astro";
import { experience } from "../data/experience.ts";
---

<section id="experience" class="section wrap" aria-labelledby="experience-title">
  <SectionHead index="03" kicker="deploy history" title="Experience" id="experience-title">
    Roles, newest first. Every one of them shipped to production.
  </SectionHead>

  <ol class="log sbody">
    {
      experience.map((r, i) => {
        const live = /now|present/i.test(r.year);
        return (
          <li class={`dep ${live ? "live" : ""}`}>
            <div class="when">
              <span class="ver">v{experience.length - i}.0</span>
              <span class="yr">{r.year}</span>
              {live ? (
                <span class="pill">
                  <span class="dot pulse" aria-hidden="true" />
                  running
                </span>
              ) : (
                <span class="pill idle">exit 0</span>
              )}
            </div>
            <div class="rail" aria-hidden="true">
              <span class="node" />
            </div>
            <article class="card panel">
              <h3>
                {r.title} <span class="co">@ {r.company}</span>
              </h3>
              <p>{r.blurb}</p>
              {r.impact && (
                <ul class="impact" aria-label="Impact">
                  {r.impact.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
              )}
              <ul class="tags" aria-label="Tools">
                {r.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </article>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .log {
    list-style: none;
  }
  .dep {
    display: grid;
    grid-template-columns: 168px 36px minmax(0, 1fr);
    grid-template-areas: "when rail card";
  }
  .when {
    grid-area: when;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding-top: 22px;
    font-family: var(--mono);
  }
  .ver {
    font-size: 12px;
    color: var(--dim);
  }
  .yr {
    font-size: 14px;
    color: var(--fg);
    white-space: nowrap;
  }
  .when .pill {
    margin-top: 4px;
  }
  .when .pill .dot {
    width: 6px;
    height: 6px;
  }

  .rail {
    grid-area: rail;
    position: relative;
  }
  .rail::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line-2);
  }
  .dep:first-child .rail::before {
    top: 30px;
  }
  .dep:last-child .rail::before {
    bottom: auto;
    height: 30px;
  }
  .node {
    position: absolute;
    left: 50%;
    top: 24px;
    width: 13px;
    height: 13px;
    margin-left: -6.5px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--line-2);
  }
  .live .node {
    border-color: var(--ok);
    background: var(--ok);
    box-shadow: 0 0 0 4px var(--ok-soft);
  }

  .card {
    grid-area: card;
    padding: 22px 24px;
    margin-bottom: 18px;
    transition: border-color 0.2s;
  }
  .card:hover {
    border-color: var(--line-2);
  }
  .live .card {
    border-color: var(--ok-line);
  }
  h3 {
    font-family: var(--display);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .co {
    color: var(--ok);
    font-weight: 500;
  }
  p {
    margin-top: 10px;
    color: var(--mut);
    font-size: 15px;
    line-height: 1.7;
    max-width: 70ch;
  }
  .impact,
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .impact {
    margin-top: 16px;
  }
  .impact li {
    font-family: var(--mono);
    font-size: 12px;
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--ok-soft);
    color: var(--ok);
    border: 1px solid var(--ok-line);
  }
  .tags {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
  }
  .tags li {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mut);
  }
  .tags li::before {
    content: "#";
    color: var(--dim);
    margin-right: 1px;
  }

  @media (max-width: 760px) {
    .dep {
      grid-template-columns: 22px minmax(0, 1fr);
      grid-template-areas:
        "rail when"
        "rail card";
      column-gap: 10px;
    }
    .rail::before {
      left: 10px;
    }
    .node {
      left: 10px;
    }
    .when {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 12px;
      padding: 20px 0 10px;
    }
    .when .pill {
      margin-top: 0;
    }
    .card {
      padding: 18px;
    }
    h3 {
      font-size: 18px;
    }
  }
</style>
