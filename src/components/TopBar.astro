---
// Sticky console header: identity + breadcrumb, section nav, local clock,
// command palette trigger, theme toggle.
import { site } from "../data/site.ts";

interface Props {
  /** Section links. Defaults to the site's in-page nav. */
  nav?: readonly { label: string; href: string }[];
  /** Breadcrumb after the name, e.g. ["prod", "ca-ottawa-1"]. */
  crumb?: readonly string[];
}
const { nav = site.nav, crumb = ["prod", site.region] } = Astro.props;
---

<header class="topbar">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16">
          <path d="M2 13h4l2.5-6 4 11 3-8 1.5 3H22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="nm">sanjay<span class="p">.</span>hona</span>
      <span class="crumb" aria-hidden="true">{crumb.map((c, i) => <><span>/</span> {c}{i < crumb.length - 1 ? " " : ""}</>)}</span>
    </a>

    <nav class="nav" aria-label="Sections">
      {nav.map((n) => <a href={n.href} data-nav>{n.label}</a>)}
    </nav>

    <div class="tools">
      <span class="clock" title={`Local time in ${site.location}`}>
        <span class="dot pulse" aria-hidden="true"></span>
        <span class="sr-only">Local time in {site.location}:</span>
        <span data-clock>--:--</span>
        <span class="tz" data-tzlabel>{site.timezoneLabel}</span>
      </span>
      <button class="tbtn cmdk" type="button" data-palette-open aria-label="Open command palette">
        <span class="gt" aria-hidden="true">&gt;_</span>
        <kbd aria-hidden="true"><span data-mod>⌘</span>K</kbd>
      </button>
      <button class="tbtn" type="button" data-toggle aria-label="Switch to light theme">
        <svg class="sun" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
        </svg>
        <span class="sr-only" data-tl>light</span>
      </button>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    height: 60px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 14px;
    white-space: nowrap;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    color: var(--ok);
    background: var(--ok-soft);
    border: 1px solid var(--ok-line);
  }
  .nm {
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .nm .p {
    color: var(--ok);
  }
  .crumb {
    color: var(--dim);
    font-size: 12.5px;
  }
  .crumb span {
    color: var(--line-2);
    padding: 0 2px;
  }

  .nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  .nav a {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--mut);
    padding: 6px 10px;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }
  .nav a:hover {
    color: var(--fg);
    background: var(--panel-2);
  }
  .nav a.on {
    color: var(--ok);
    background: var(--ok-soft);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .clock {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--fg-2);
    padding: 0 10px 0 4px;
    font-variant-numeric: tabular-nums;
  }
  .clock .tz {
    color: var(--dim);
  }
  .tbtn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 10px;
    border-radius: 7px;
    border: 1px solid var(--line-2);
    background: var(--panel);
    color: var(--mut);
    cursor: pointer;
    font-family: var(--mono);
    font-size: 12px;
    transition: color 0.15s, border-color 0.15s;
  }
  .tbtn:hover {
    color: var(--fg);
    border-color: var(--mut);
  }
  .cmdk .gt {
    display: none;
    color: var(--ok);
  }
  .cmdk kbd {
    border: 0;
    background: none;
    padding: 0;
    font-size: 12px;
    color: inherit;
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme="light"]) .sun {
    display: none;
  }
  :global(:root[data-theme="light"]) .moon {
    display: block;
  }

  @media (max-width: 1060px) {
    .crumb {
      display: none;
    }
  }
  @media (max-width: 880px) {
    .bar {
      height: auto;
      flex-wrap: wrap;
      row-gap: 0;
      padding-top: 12px;
    }
    .tools {
      margin-left: auto;
    }
    .clock {
      display: none;
    }
    .nav {
      order: 3;
      width: calc(100% + 2 * var(--gutter));
      margin: 10px calc(-1 * var(--gutter)) 0;
      padding: 0 var(--gutter) 8px;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
      mask-image: linear-gradient(90deg, #000 85%, transparent);
    }
    .nav::-webkit-scrollbar {
      display: none;
    }
    .nav a {
      flex: none;
      padding: 6px 9px;
    }
  }
  @media (hover: none) {
    .cmdk kbd {
      display: none;
    }
    .cmdk .gt {
      display: inline;
    }
  }
</style>
