---
// Self-hosted fonts (only the weights actually used)
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";

import "../styles/global.css";
import CommandPalette from "../components/CommandPalette.astro";
import { site } from "../data/site.ts";
import { themeBootstrap, themeBootstrapHash } from "../lib/theme.ts";

interface Props {
  title?: string;
  description?: string;
  /** OG/Twitter card image — absolute path under /public. */
  image?: string;
  /** og:type — "website" for the home page, "article" for case studies. */
  type?: "website" | "article";
  /** Page-specific JSON-LD. Falls back to the Person + WebSite identity graph. */
  structuredData?: object;
  /** Keep the page out of search results (404). Also drops canonical/og:url. */
  noindex?: boolean;
  /** og:site_name. */
  siteName?: string;
  /** Command palette nav. Defaults to the site's section nav. */
  nav?: readonly { label: string; href: string }[];
}

const {
  title = `${site.name} — ${site.currentTitle}`,
  description = site.metaDescription,
  image = site.ogImage,
  type = "website",
  structuredData,
  noindex = false,
  siteName = `${site.name} — Portfolio`,
  nav,
} = Astro.props;

// Astro.site is set in astro.config.mjs, so these resolve to absolute URLs —
// required by Open Graph (relative image paths are silently dropped by crawlers).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(image, Astro.site).href;

// Identity graph: a single Person node other pages can reference by @id, plus
// the WebSite. sameAs ties the social profiles into one entity for Google.
const personId = `${site.url}/#person`;
const identityGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: site.name,
      url: site.url,
      image: ogImageUrl,
      jobTitle: site.jobTitle,
      email: `mailto:${site.email}`,
      worksFor: { "@type": "Organization", name: site.currentCompany },
      address: {
        "@type": "PostalAddress",
        addressLocality: "Ottawa",
        addressRegion: "ON",
        addressCountry: "CA",
      },
      sameAs: site.socials
        .filter((s) => s.href.startsWith("http"))
        .map((s) => s.href),
      knowsAbout: [
        "Site Reliability Engineering",
        "DevOps",
        "DevSecOps",
        "Kubernetes",
        "Terraform",
        "Amazon Web Services",
        "CI/CD",
        "Observability",
        "AIOps",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: site.url,
      name: `${site.name} — Portfolio`,
      inLanguage: "en",
      publisher: { "@id": personId },
    },
  ],
};
// Escape "<" so data can never close the <script> block early.
const jsonLd = JSON.stringify(structuredData ?? identityGraph).replace(/</g, "\\u003c");

// Inline theme bootstrap (src/lib/theme.ts), allowed by the CSP via its hash.
Astro.csp?.insertScriptHash(themeBootstrapHash);
---

<!doctype html>
<html lang="en" data-tz={site.timezone}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta
      name="robots"
      content={noindex ? "noindex" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    {!noindex && <link rel="canonical" href={canonical} />}

    <!-- Icons & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${site.name}, ${site.jobTitle}`}
    />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={jsonLd}
    />

    <!-- Theme color tracks resolved theme; updated by the bootstrap script -->
    <meta name="theme-color" content="#080b10" id="theme-color" />

    <!-- data-cfasync="false": Cloudflare Rocket Loader must not defer this. -->
    <script is:inline data-cfasync="false" set:html={themeBootstrap} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <CommandPalette nav={nav} />
    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>

<script>
  import { initConsole } from "../scripts/console.ts";
  initConsole();
</script>

<style is:global>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 10px 14px;
    border-radius: 8px;
    background: var(--ok);
    color: #04130b;
    font-family: var(--mono);
    font-size: 13px;
  }
  .skip:focus {
    top: 12px;
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    z-index: 90;
    transform: translate(-50%, 16px);
    opacity: 0;
    pointer-events: none;
    font-family: var(--mono);
    font-size: 13px;
    padding: 10px 14px;
    border-radius: 8px;
    background: var(--panel);
    border: 1px solid var(--ok-line);
    color: var(--fg);
    box-shadow: var(--shadow);
    transition: opacity 0.2s, transform 0.2s;
  }
  .toast.on {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
