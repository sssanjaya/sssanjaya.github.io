---
import BlogLayout from "../layouts/BlogLayout.astro";
import PostList from "../components/PostList.astro";
import { blog, getPosts } from "../lib/posts.ts";
import { site } from "../../../src/data/site.ts";

const posts = await getPosts();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://blog.sanjayhona.com.np/#blog",
  name: blog.title,
  url: Astro.site?.href,
  description: blog.description,
  inLanguage: "en",
  author: { "@type": "Person", "@id": `${site.url}/#person`, name: site.name, url: site.url },
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    "@id": `https://blog.sanjayhona.com.np/${p.id}/#post`,
    headline: p.data.title,
    url: `https://blog.sanjayhona.com.np/${p.id}/`,
    datePublished: p.data.date.toISOString(),
  })),
};
---

<BlogLayout title={blog.title} structuredData={structuredData}>
  <section class="wrap head">
    <p class="pill">
      <span class="dot pulse" aria-hidden="true"></span>
      log stream · {posts.length} {posts.length === 1 ? "entry" : "entries"}
    </p>
    <h1>Field notes</h1>
    <p class="lede">
      Incident write-ups, runbooks, and what I learn running cloud and edge
      infrastructure. Written for the next person on call, which is usually me.
    </p>
  </section>
  <section class="wrap list" aria-label="Posts">
    <PostList posts={posts} />
  </section>
</BlogLayout>

<style>
  .head {
    padding-top: 80px;
    padding-bottom: 40px;
  }
  h1 {
    margin-top: 22px;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(44px, 6vw, 72px);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .lede {
    margin-top: 18px;
    font-size: 18px;
    color: var(--fg-2);
    max-width: 58ch;
  }
  @media (max-width: 720px) {
    .head {
      padding-top: 48px;
      padding-bottom: 28px;
    }
    .lede {
      font-size: 16.5px;
    }
  }
</style>
